{
  "manifest_version": 2,
  "name": "Fire Vs Fire",
  "description": "A starter template for a Firefox WebExtension.",
  "version": "0.1.0",
  "icons": {
    "128": "icons/icon.svg"
  },
  "browser_action": {
    "default_title": "Open Options",
    "default_popup": "options/options.html",
    "default_icon": "icons/icon.svg"
  },
  "web_accessible_resources": [
    "icons/icon.svg",
    "icons/icon-loading.svg"
  ],
"background": {
    "scripts": ["background/background.js"]
  },
"permissions": [
  "storage",
  "activeTab",
  "contextMenus",
  "nativeMessaging",
  "<all_urls>"
],
"content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
"options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
"browser_specific_settings": {
    "gecko": {
      "id": "template@example.com",
      "strict_min_version": "57.0"
    }
  }
}
