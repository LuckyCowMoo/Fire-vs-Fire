{
  "manifest_version": 3,
  "name": "Fire Vs Fire",
  "description": "Local, hardware-accelerated AI & custom content detector powered by Fire vs Fire classifiers.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Options",
    "default_popup": "options/options.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.svg",
        "icons/icon-loading.svg",
        "icons/icon-16.png",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-128.png",
        "icons/icon-loading-16.png",
        "icons/icon-loading-32.png",
        "icons/icon-loading-48.png",
        "icons/icon-loading-128.png",
        "options/preview-fire.jpg",
        "options/assets/*",
        "docs/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background/background.js",
    "scripts": ["background/background.js"]
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/visualEffects.js", "shared/ensembles.js", "shared/textUtils.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "template@example.com",
      "strict_min_version": "109.0"
    }
  },
  "key": ""
}
